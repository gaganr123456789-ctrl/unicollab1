# ==============================================================================
# UNICOLLAB ENVIRONMENT VARIABLES TEMPLATE
# Copy to .env and supply your secrets before starting the server.
# ==============================================================================

# Server & Network Configuration
PORT=5000
NODE_ENV=production
APP_URL=https://unicollab1.onrender.com

# PostgreSQL / Supabase Database URL (Prisma ORM)
DATABASE_URL=postgresql://postgres:PASSWORD@HOST:5432/postgres?sslmode=require

# JWT Authentication Secret
JWT_SECRET=your_jwt_secret_key_here

# Resend API Key for OTP & Verification Emails
RESEND_API_KEY=re_your_resend_api_key_here
EMAIL_FROM=onboarding@resend.dev

# Google OAuth Single Sign-On (Optional)
GOOGLE_CLIENT_ID=your_google_oauth_client_id.apps.googleusercontent.com

# AI Matchmaker & Assistant (Gemini / Groq)
GEMINI_API_KEY=your_gemini_api_key_here
GROQ_API_KEY=your_groq_api_key_here

# Admin Security & Passkey Configuration
ADMIN_DEFAULT_KEY=your_admin_passkey_here
ADMIN_EMAIL_1=gagan.r123456789@gmail.com
ADMIN_EMAIL_2=charanyajagannath0982@gmail.com