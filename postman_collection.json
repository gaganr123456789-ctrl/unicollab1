{
  "info": {
    "name": "UniCollab Production REST API Collection",
    "description": "Complete independent endpoint testing collection for UniCollab Express & Prisma Backend.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "Sign Up / Register",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Alex Rivera\",\n  \"email\": \"alex@stanford.edu\",\n  \"password\": \"password123\",\n  \"university\": \"Stanford University\",\n  \"major\": \"Computer Science & Engineering (CSE)\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/api/auth/signup", "host": ["{{baseUrl}}"], "path": ["api", "auth", "signup"] }
          }
        },
        {
          "name": "Log In",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"alex@stanford.edu\",\n  \"password\": \"password123\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/api/auth/login", "host": ["{{baseUrl}}"], "path": ["api", "auth", "login"] }
          }
        },
        {
          "name": "Get Authenticated User Profile",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{jwtToken}}" }],
            "url": { "raw": "{{baseUrl}}/api/auth/me", "host": ["{{baseUrl}}"], "path": ["api", "auth", "me"] }
          }
        }
      ]
    },
    {
      "name": "Dashboard",
      "item": [
        {
          "name": "Get Dashboard Aggregated Stats",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{jwtToken}}" }],
            "url": { "raw": "{{baseUrl}}/api/dashboard", "host": ["{{baseUrl}}"], "path": ["api", "dashboard"] }
          }
        }
      ]
    },
    {
      "name": "Find Teammates",
      "item": [
        {
          "name": "Search Teammates by Skills & Major",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/users/search?search=Sarah&skill=React",
              "host": ["{{baseUrl}}"],
              "path": ["api", "users", "search"],
              "query": [
                { "key": "search", "value": "Sarah" },
                { "key": "skill", "value": "React" }
              ]
            }
          }
        }
      ]
    },
    {
      "name": "Projects Marketplace",
      "item": [
        {
          "name": "Get All Projects",
          "request": {
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/api/projects", "host": ["{{baseUrl}}"], "path": ["api", "projects"] }
          }
        },
        {
          "name": "Create Project",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{jwtToken}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"AI Autonomous Research Agent\",\n  \"description\": \"Building multi-agent autonomous reasoning models.\",\n  \"category\": \"AI & Machine Learning\",\n  \"tags\": [\"Python\", \"PyTorch\"]\n}"
            },
            "url": { "raw": "{{baseUrl}}/api/projects", "host": ["{{baseUrl}}"], "path": ["api", "projects"] }
          }
        }
      ]
    },
    {
      "name": "Team Workspace (Kanban)",
      "item": [
        {
          "name": "Get Boards",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{jwtToken}}" }],
            "url": { "raw": "{{baseUrl}}/api/boards", "host": ["{{baseUrl}}"], "path": ["api", "boards"] }
          }
        },
        {
          "name": "Drag & Drop PATCH Card Position",
          "request": {
            "method": "PATCH",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{jwtToken}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"columnId\": \"in_progress\",\n  \"position\": 1.5\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/boards/board_main/cards/1",
              "host": ["{{baseUrl}}"],
              "path": ["api", "boards", "board_main", "cards", "1"]
            }
          }
        }
      ]
    }
  ]
}
